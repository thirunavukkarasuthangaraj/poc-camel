# ════════════════════════════════════════════════════════════════════
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && vi .env
# ════════════════════════════════════════════════════════════════════

# ── Where the broker listens ────────────────────────────────────────
# The WireGuard address of THIS VM, e.g. 10.9.0.1.
# Leave unset and everything binds to 127.0.0.1, which is safe but
# means the bridge cannot reach it. NEVER set this to 0.0.0.0.
BIND_ADDR=10.9.0.1

# ── Broker credentials ──────────────────────────────────────────────
# Do NOT reuse thiru/password from the lab. Generate something real:
#   openssl rand -base64 24
RABBITMQ_USER=
RABBITMQ_PASS=

# ── Payload encryption ──────────────────────────────────────────────
# Must be byte-identical to SCADA_AES_KEY in the bridge's Kubernetes
# secret, or every forward message fails to decrypt.
#
# Generate a NEW one for this deployment and set it on both sides:
#   openssl rand -base64 32
#
# Do not reuse k7Qh2NfT8vR0mC9aXy4pLwZbE3sG6uJtH1iKd5oArMw= — that value
# is committed to the repository and is also the application's own
# hardcoded fallback, so it protects nothing.
SCADA_AES_KEY=

# ── Dashboard binding ───────────────────────────────────────────────
# Loopback by default; reach it over an SSH tunnel:
#   ssh -L 8091:127.0.0.1:8091 root@<vm>
# Set to the WireGuard address if you want it on the tunnel instead.
DASHBOARD_BIND=127.0.0.1

# ── Optional: STOMP injector back into TMS ──────────────────────────
# Only works if this VM can reach Artemis across the tunnel. Leave
# blank to disable. ARTEMIS_HOST would be the TMS-side tunnel address.
ARTEMIS_HOST=
ARTEMIS_USER=
ARTEMIS_PASS=
